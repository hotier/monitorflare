{
  "name": "monitorflare-worker",
  "version": "1.0.0",
  "private": true,
  "description": "MonitorFlare monitoring engine (Cloudflare Worker)",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "cross-env WRANGLER_SEND_METRICS=false wrangler dev --ip 0.0.0.0",
    "dev:remote": "wrangler dev --remote --ip 0.0.0.0",
    "start": "cross-env WRANGLER_SEND_METRICS=false wrangler dev --ip 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260915.1",
    "cross-env": "^7.0.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "4.124.0"
  },
  "dependencies": {
    "hono": "^4.12.23"
  }
}
